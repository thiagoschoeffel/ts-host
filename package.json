{
  "name": "ts-host",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 4173",
    "build": "vue-tsc --noEmit && vite build",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "ci": "npm run build && npm run check:bundle"
  },
  "bundleBudget": {
    "js": { "bytes": 1800000, "gzipBytes": 450000 },
    "css": { "bytes": 100000, "gzipBytes": 20000 },
    "remoteEntry": { "bytes": 25000, "gzipBytes": 8000 }
  },
  "dependencies": {
    "@thiagoschoeffel/ts-components": "^0.7.8",
    "oidc-client-ts": "^3.5.0",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@module-federation/vite": "^1.21.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vue-tsc": "^3.1.5"
  }
}
